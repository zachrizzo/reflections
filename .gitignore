# Unreal-generated output and local editor state
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Plugins/**/Binaries/
/Plugins/**/DerivedDataCache/
/Plugins/**/Intermediate/
/Plugins/**/Saved/

# Generated IDE files
/.vs/
/*.sln
/*.slnx
/*.xcworkspace/
/*.xcodeproj/
*.VC.db
*.VC.opendb
*.suo
*.user

# Python bytecode
__pycache__/
*.pyc

# Secrets and the built voice helper: never commit API keys or the 29 MB relay exe
/Content/NpcDialogue/Relay/
**/keys*.json
!**/keys.json.example
*.env

# PyInstaller output for the voice relay (rebuilt from NpcDialogueRelay.spec)
/Tools/RealtimeVoice/build/
/Tools/RealtimeVoice/dist/

# Garment-prep caches (rebuilt by the scripts that read them)
/Tools/ClothingFit/garmentprep/_field_*.pkl

# QA copies of the cast that the garment captures rebuild every run
/Content/Characters/Clothing/VillageWardrobe/Generated/QA/

# Claude Code runtime lock
/.claude/scheduled_tasks.lock
